# ============================================================
# miiCase / miiSpine AR — environment
# Copy to .env and fill in. Never commit real keys.
# ============================================================

# --- Supabase project ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key                 # used by the dashboard (public, RLS-protected)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key # used by the autopilot function ONLY (server-side)

# --- Autopilot edge function ---
ANTHROPIC_API_KEY=sk-ant-...
SENDGRID_API_KEY=SG....                          # optional; omit to run autopilot in dry-run
AUTOPILOT_DRY_RUN=true                           # "true" = draft + log but do not send
AUTOPILOT_FROM_EMAIL=billing@miispine.com
AUTOPILOT_BATCH_SIZE=50

# --- ModMed EMR sync (read-only AR pull) ---
# Held only by the modmed-sync edge function. Never expose to the browser.
# Requires a ModMed API entitlement + your covered Supabase BAA in place.
MODMED_BASE_URL=https://your-env.ema-api.com/ema-prod/firm/your-prefix/ema/fhir/v2
MODMED_API_KEY=your-modmed-x-api-key
MODMED_USERNAME=your-modmed-api-user
MODMED_PASSWORD=your-modmed-api-password
# MODMED_TOKEN_URL=                              # optional; defaults from MODMED_BASE_URL
MODMED_DRY_RUN=true                              # "true" = stage + report, don't touch bills
